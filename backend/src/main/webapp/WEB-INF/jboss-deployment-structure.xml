<?xml version="1.0" encoding="UTF-8"?>
<jboss-deployment-structure xmlns="urn:jboss:deployment-structure:1.3">
    <deployment>

        <!-- Evita que WildFly maneje el logging del WAR.
             Spring Boot usará su propio Logback. -->
        <exclude-subsystems>
            <subsystem name="logging"/>
            <subsystem name="jpa"/>
        </exclude-subsystems>

        <!-- Evita que WildFly inyecte sus módulos de logging/JPA/Hibernate
             y choque con las versiones que vienen dentro del WAR de Spring Boot. -->
        <exclusions>
            <module name="org.slf4j"/>
            <module name="org.slf4j.impl"/>

            <module name="org.hibernate"/>
            <module name="org.hibernate.orm"/>
            <module name="jakarta.persistence.api"/>
        </exclusions>

    </deployment>
</jboss-deployment-structure>